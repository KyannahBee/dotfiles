/**
 * Pixel Castle — rofi launcher theme
 * Palette matches waybar/style.css + kitty.conf
 */

configuration {
    font:                       "JetBrains Mono NF 13";
    modi:                       "drun,run,window";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    bg:         #1a1624;
    bg-alt:     #2e2640;
    purple:     #7b6b9e;
    purple-hi:  #a08bc0;
    stone:      #c8bfd8;
    pink:       #c87fa0;
    teal:       #4a9e8a;
    text:       #e8dff0;
    subtext:    #a899b8;
    border-col: #3d3355;

    background-color: transparent;
    text-color:        @text;
}

window {
    location:           center;
    width:               480px;
    border:               1px;
    border-color:        @pink;
    border-radius:        0px;
    background-color:    @bg;
}

mainbox {
    background-color: transparent;
    children:          [ "inputbar", "listview" ];
    spacing:            0px;
    padding:             0px;
}

inputbar {
    background-color: @bg-alt;
    text-color:         @text;
    border:             0px 0px 1px 0px;
    border-color:       @border-col;
    padding:             10px 12px;
    children:           [ "prompt", "entry" ];
    spacing:             8px;
}

prompt {
    text-color: @pink;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @subtext;
    text-color:         @text;
}

listview {
    background-color: transparent;
    columns:            1;
    lines:               8;
    spacing:             2px;
    padding:             6px;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    fixed-height:        true;
}

element {
    background-color: transparent;
    text-color:         @subtext;
    padding:             6px 10px;
    border-radius:        0px;
}

element-icon {
    size:             1.1em;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element selected {
    background-color: @bg-alt;
    text-color:         @text;
    border:             0px 0px 0px 2px;
    border-color:       @pink;
}

element urgent {
    text-color: @pink;
}

error-message {
    background-color: @bg;
    text-color:         @pink;
    border:             1px;
    border-color:       @pink;
    padding:             10px;
}
