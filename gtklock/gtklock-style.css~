/* ============================================================
   gtklock — pixel art castle theme
   Matches sway/config + waybar/style.css + kitty.conf palette
   bg:         #1a1624  (night sky base)
   bg-alt:     #221d2e  (panel surface)
   surface:    #2e2640  (input/button surface)
   purple:     #7b6b9e  (clouds/sky)
   purple-hi:  #a08bc0  (light cloud highlights)
   stone:      #c8bfd8  (castle stone, light text)
   pink:       #c87fa0  (accent, castle trim)
   teal:       #4a9e8a  (tree canopy, success/unlock)
   water:      #3d4a7a  (lake/river)
   text:       #e8dff0  (off-white, readable)
   subtext:    #a899b8  (muted purple-gray)
   border_in:  #3d3355  (matches sway $border_in)
   ============================================================
   Widget IDs below are taken straight from gtklock's res/gtklock.ui
   (v0.5.x source) — not guessed. If your gtklock package version
   ships a different .ui (check CHANGELOG if so), these selectors
   may need re-verifying against your installed version.
   ============================================================ */

/* ---- Window / background ----
   Per sway/outputs you have eDP-1 + HDMI-A-1. gtklock names each
   window after the output (window#eDP-1, window#HDMI-A-1) — same
   mechanism your sway "output" lines key off. Background image is
   set via gtklock's -b/--background flag or config.ini; this just
   sets the fallback color + ensures no GTK theme bleed-through. */
window {
    background-color: #1a1624;
    color: #e8dff0;
    font-family: "JetBrains Mono NF", "JetBrainsMono Nerd Font", monospace;
    font-size: 12px;
}

/* Optional: per-output background image, matching your sway wallpaper.
   Uncomment + point at the same file as `output * bg ... fill` in sway/config
   if you want gtklock to show the castle art instead of flat bg color. */
/*
window {
    background-image: url("/home/kyannahm/.config/sway/wallpaper.jpg");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
}
*/

/* Sharp edges everywhere — matches your sway config's explicit
   "pixel art, no rounded corners" comment block */
* {
    border-radius: 0;
}

/* ---- Outer container ---- */
#window-box {
    background-color: transparent;
}

/* ---- Clock block ---- */
#info-box {
    margin-bottom: 12px;
}

#clock-label {
    color: #e8dff0;
    font-size: 56px;
    font-weight: bold;
}

#date-label {
    color: #a899b8;
    font-size: 16px;
}

/* ---- Password prompt row ---- */
#input-label {
    color: #c8bfd8;
    font-size: 13px;
}

#input-field {
    background-color: #2e2640;
    color: #e8dff0;
    caret-color: #c87fa0;
    border: 1px solid #3d3355;
    padding: 8px 10px;
}

#input-field:focus {
    border-color: #c87fa0;
}

/* GtkEntry's reveal-password icon (secondary icon) */
#input-field image {
    color: #a899b8;
}

/* ---- Status labels ---- */
#warning-label {
    color: #a08bc0; /* caps-lock warning */
    font-size: 12px;
}

#error-label {
    color: #c87fa0; /* login failed */
    font-size: 12px;
    font-weight: bold;
}

/* ---- Unlock button ----
   Ships with a .suggested-action style class by default (blue in
   Adwaita) — override directly so it doesn't fight this theme. */
#unlock-button {
    background-color: #c87fa0;
    background-image: none;
    color: #1a1624;
    border: 1px solid #e8a0c0;
    padding: 6px 18px;
    font-weight: bold;
}

#unlock-button:hover {
    background-color: #a08bc0;
    background-image: none;
}

#unlock-button:active,
#unlock-button:focus {
    background-color: #b86c8e;
    background-image: none;
}

#unlock-button:disabled {
    background-color: #3d3355;
    color: #a899b8;
    border-color: #3d3355;
}

/* ---- Info bar messages (PAM messages, e.g. fingerprint prompts) ---- */
infobar {
    background-color: #221d2e;
    color: #e8dff0;
    border: 1px solid #3d3355;
}

infobar.error {
    border-color: #c87fa0;
}

infobar.info {
    border-color: #4a9e8a;
}

/* ---- Idle state (idle-hide module option) ----
   gtklock adds a `.hidden` class to the window when idle —
   nothing visually needed here since the form is hidden, but
   keeping bg consistent if a compositor effect peeks through. */
window.hidden {
    background-color: #1a1624;
}
